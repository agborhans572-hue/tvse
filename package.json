{
  "name": "tvse-travel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run typecheck && npm run operations:check && npm run build && tsx --test tests/*.test.mjs",
    "test:unit": "tsx --test tests/travel-core.test.mjs tests/launch-security.test.mjs tests/scaling-foundation.test.mjs",
    "test:migrations": "tsx --test tests/migration.test.mjs tests/scaling-foundation.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern node_modules_stale --ignore-pattern .codex-run --ignore-pattern '*.tsbuildinfo'",
    "db:generate": "drizzle-kit generate",
    "operations:dev": "wrangler dev --config workers/operations/wrangler.jsonc --port 8788",
    "operations:check": "wrangler deploy --dry-run --config workers/operations/wrangler.jsonc",
    "operations:deploy": "wrangler deploy --config workers/operations/wrangler.jsonc",
    "fixtures:scale": "tsx scripts/generate-scale-fixtures.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "framer-motion": "^13.4.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/workers-types": "5.20260921.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.3.0",
    "wrangler": "4.136.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
