{
  "name": "tvse-travel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run typecheck && npm run operations:check && npm run build && tsx --test tests/*.test.mjs",
    "test:unit": "tsx --test tests/travel-core.test.mjs tests/launch-security.test.mjs tests/scaling-foundation.test.mjs",
    "test:migrations": "tsx --test tests/migration.test.mjs tests/scaling-foundation.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern node_modules_stale --ignore-pattern .codex-run --ignore-pattern '*.tsbuildinfo'",
    "db:generate": "drizzle-kit generate",
    "operations:dev": "wrangler dev --config workers/operations/wrangler.jsonc --port 8788",
    "operations:check": "wrangler deploy --dry-run --config workers/operations/wrangler.jsonc",
    "operations:deploy": "wrangler deploy --config workers/operations/wrangler.jsonc",
    "fixtures:scale": "tsx scripts/generate-scale-fixtures.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.1",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
